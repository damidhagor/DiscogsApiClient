<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<AnalysisMode>All</AnalysisMode>
		<LangVersion>latest</LangVersion>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
	</PropertyGroup>

	<PropertyGroup>
		<Title>DiscogsApiClient</Title>
		<Authors>Alexander Jurk</Authors>
		<Description>This is a library for authenticated access to the Discogs database.</Description>
		<PackageProjectUrl>https://github.com/damidhagor/DiscogsApiClient</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/damidhagor/DiscogsApiClient</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>discogs</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyVersion>5.0.0</AssemblyVersion>
		<FileVersion>5.0.0</FileVersion>
		<PackageVersion>5.0.0-test1</PackageVersion>
		<PackageReleaseNotes>v5.0.0: Dropped .NET 6/7 support (now targets .NET 8, 9 and 10). Rewrote the client implementation on a fully incremental (IIncrementalGenerator) source generator. Removed client-side rate limiting in favor of IDiscogsRateLimitStateService. Modernized DI registration (IOptions&lt;T&gt; with ValidateOnStart) and authentication provider registration (explicit opt-in via WithPatAuthentication/WithOAuthAuthentication). Contains multiple breaking changes -- see https://github.com/damidhagor/DiscogsApiClient/blob/main/docs/MIGRATION_GUIDE.md and https://github.com/damidhagor/DiscogsApiClient/blob/main/docs/CHANGELOG.md for full details.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DiscogsApiClient.SourceGenerator\DiscogsApiClient.SourceGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DiscogsApiClient.Tests" />
	</ItemGroup>
</Project>
